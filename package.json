{
	"name": "@bhsd/codemirror-stickyscroll",
	"version": "0.1.0",
	"description": "VS Code / Monaco-style sticky scroll (sticky lines) extension for CodeMirror 6",
	"keywords": [
		"codemirror",
		"sticky"
	],
	"homepage": "https://github.com/bhsd-harry/stickyscroll#readme",
	"bugs": {
		"url": "https://github.com/bhsd-harry/stickyscroll/issues"
	},
	"license": "MIT",
	"contributors": [
		"[Zulfazli (Fazelllyyy)](https://github.com/fazelllyyy)",
		"Bhsd"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/bhsd-harry/codemirror-stickyscroll.git"
	},
	"type": "module",
	"files": [
		"/dist/"
	],
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"sideEffects": false,
	"scripts": {
		"prepublishOnly": "npm run build",
		"lint:ts": "tsc --noEmit && eslint --cache .",
		"lint:md": "markdownlint-cli2 '**/*.md'",
		"lint:css": "stylelint --cache '**/*.css'",
		"lint": "npm run lint:ts && npm run lint:css && npm run lint:md",
		"build": "tsc && eslint --no-inline-config --no-config-lookup -c eslint.dist.js dist/*.js"
	},
	"peerDependencies": {
		"@codemirror/language": "^6.0.0",
		"@codemirror/state": "^6.0.0",
		"@codemirror/view": "^6.0.0",
		"@lezer/common": "^1.0.0",
		"@lezer/highlight": "^1.0.0"
	},
	"devDependencies": {
		"@bhsd/code-standard": "^4.1.0",
		"@codemirror/language": "^6.12.4",
		"@codemirror/state": "^6.7.1",
		"@codemirror/view": "^6.43.8",
		"eslint": "^10.8.1",
		"markdownlint-cli2": "^0.23.2",
		"stylelint": "^17.14.1",
		"typescript": "^6.0.3"
	}
}
