{
  "name": "@fazelstudio/codemirror-stickyscroll",
  "version": "0.1.0",
  "description": "VS Code / Monaco-style sticky scroll (sticky lines) extension for CodeMirror 6",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "author": "[Zulfazli (Fazelllyyy)](https://github.com/fazelllyyy)",
  "repository": {
    "type": "git",
    "url": "https://github.com/fazelllyyy/codemirror-stickyscroll.git"
  },
  "keywords": [
    "codemirror",
    "codemirror6",
    "sticky",
    "sticky-scroll",
    "sticky-lines",
    "editor"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "vite example",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@codemirror/language": "^6.0.0",
    "@codemirror/state": "^6.0.0",
    "@codemirror/view": "^6.0.0",
    "@lezer/common": "^1.0.0",
    "@lezer/highlight": "^1.0.0"
  },
  "devDependencies": {
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.8",
    "@lezer/common": "^1.5.2",
    "@lezer/highlight": "^1.2.3",
    "codemirror": "^6.0.2",
    "jsdom": "^30.0.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@codemirror/lang-html": "^6.4.12"
  }
}
